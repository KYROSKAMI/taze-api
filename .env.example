# TAZE API — Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Environment mode: 'development' | 'production'
NODE_ENV=development

# TAZE Admin Secret Key (used for privileged extension installation / management)
TAZE_ADMIN_KEY="taze-dev-secret"

# Optional Upstream AniList GraphQL Endpoint (default: https://graphql.anilist.co)
ANILIST_GRAPHQL_ENDPOINT="https://graphql.anilist.co"

# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled in platform)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
